# Copy to .env and fill in. Never commit .env.

# MOCK_MODE=true runs everything offline with deterministic synthetic answers and scores.
# Set to false (and fill in keys + model IDs) to call real providers.
MOCK_MODE=true

GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# Model IDs are configuration, not code. Check each provider's current model list:
#   Groq:   GET https://api.groq.com/openai/v1/models
#   Gemini: GET https://generativelanguage.googleapis.com/v1beta/models
# Startup validation names any ID the provider does not serve.
CHEAP_PROVIDER=groq
CHEAP_MODEL=

MID_PROVIDER=groq
MID_MODEL=

STRONG_PROVIDER=groq
STRONG_MODEL=

JUDGE_PROVIDER=gemini
JUDGE_MODEL=

# Optional backup judge, used only when the primary judge fails (quota, overload, bad JSON).
# Pick a model family different from every answering model. Leave empty to disable.
JUDGE_FALLBACK_PROVIDER=
JUDGE_FALLBACK_MODEL=

# Check configured models against the provider's model list at startup.
VALIDATE_MODELS=true

QUALITY_THRESHOLD=0.78
# Layered verification (see README): a rejection or a low-confidence acceptance gets a second
# opinion from the other judge before escalating (SmartRouter mode only).
JUDGE_CONFIDENCE_MIN=0.7
SECOND_OPINION=true
# Optional dedicated second-opinion judge: fast, and from a model family different from the primary judge
# and the answer models. Empty = use the other configured judge.
SECOND_OPINION_PROVIDER=
SECOND_OPINION_MODEL=
# Whole second opinion (retries included) must finish within this budget, else it counts as unavailable.
SECOND_OPINION_TIMEOUT_S=20
SECOND_OPINION_MAX_RETRIES=1
SECOND_OPINION_MAX_TOKENS=800
# Run the answer's labeled Python (as __main__, so its self-tests run) and its own >>> examples.
# EXECUTES MODEL-WRITTEN CODE locally with your privileges (it can read .env and files, open raw sockets, spawn processes).
# On Linux, memory, file size and process count are capped and the process group is killed on timeout (Windows: timeout only). Not a sandbox.
# Off by default; refused when HOST is not loopback.
VERIFY_EXECUTE_CODE=false
CODE_CHECK_TIMEOUT_S=10
MAX_ESCALATIONS=2
CHEAP_MAX_DIFFICULTY=0.35
MID_MAX_DIFFICULTY=0.70

GENERATION_MAX_TOKENS=1024
JUDGE_MAX_TOKENS=1024

REQUEST_TIMEOUT_S=60
MAX_RETRIES=3
RETRY_BASE_DELAY_S=1.0
MAX_CONCURRENT_REQUESTS=1
MAX_QUERY_CHARS=8000
# POST /api/query beyond this many concurrent requests gets HTTP 429; a single query can cost many provider calls.
MAX_INFLIGHT_QUERIES=4
REQUEST_DEADLINE_S=300
# Hard cap on provider calls of every kind (generation, judges, second opinions, retries) for one query.
MAX_PROVIDER_CALLS_PER_QUERY=16
# /api/stats and /api/failures summarize the most recent N queries.
STATS_WINDOW=2000

LOG_DIR=data/logs
BENCHMARK_DIR=data/benchmarks
RESULTS_DIR=benchmark/results

HOST=127.0.0.1
PORT=8000
# Host headers the API accepts (DNS-rebinding protection). Add your LAN name/IP if you change HOST.
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
